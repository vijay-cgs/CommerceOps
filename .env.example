POSTGRES_USER=commerceops
POSTGRES_PASSWORD=commerceops_dev
POSTGRES_DB=commerceops
POSTGRES_PORT=5432

DATABASE_URL=postgresql://commerceops:commerceops_dev@localhost:5432/commerceops?schema=public

# Shared HS256 signing key for session tokens. Must be identical in the API and
# web apps, and at least 32 characters. Generate a fresh random value per env.
AUTH_JWT_SECRET=replace-with-a-random-48-character-string-value

# Optional: when set, `pnpm db:seed` creates/updates the staff accounts
# (admin@, inventory@, readonly@commerceops.local) with this password.
SEED_STAFF_PASSWORD=
