generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  inventory_manager
  read_only
  customer
}

enum OrderStatus {
  confirmed
  cancelled
}

enum ProductStatus {
  draft
  active
  archived
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(customer)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  tag         String
  category    String
  accent      String
  features    String[]
  status      ProductStatus @default(draft)
  // Label for the variant axis, e.g. "Size". Null when the product has a single
  // unnamed default variant.
  optionName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants    ProductVariant[]

  @@index([status])
}

model Sku {
  id         String   @id @default(cuid())
  code       String   @unique
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  variants ProductVariant[]
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  skuId       String
  sku         String
  // Null for the default variant of a single-variant product.
  optionValue String?
  // Money is stored in minor units to avoid floating point rounding.
  priceCents  Int
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  skuRecord  Sku         @relation(fields: [skuId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([productId, skuId])
  @@index([productId])
  @@index([skuId])
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String
  status             OrderStatus @default(confirmed)
  subtotalCents      Int
  shippingCents      Int
  totalCents         Int
  shippingName       String
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  idempotencyKey     String      @unique
  correlationId      String
  createdAt          DateTime    @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  sku            String
  // Name, option and price are snapshotted so later catalog edits cannot
  // rewrite what a customer was charged.
  nameSnapshot   String
  optionSnapshot String?
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model InventoryLevel {
  id               String   @id @default(cuid())
  sku              String
  locationId       String
  availableQty     Int      @default(0)
  reservedQty      Int      @default(0)
  incomingQty      Int      @default(0)
  expectedVersion  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  adjustments      InventoryAdjustment[]

  @@unique([sku, locationId])
  @@index([locationId])
}

model InventoryAdjustment {
  id                String   @id @default(cuid())
  inventoryLevelId  String
  reasonCode        String
  deltaQty          Int
  previousAvailable Int
  newAvailable      Int
  idempotencyKey    String
  correlationId     String
  actorUserId       String
  createdAt         DateTime @default(now())

  inventoryLevel    InventoryLevel @relation(fields: [inventoryLevelId], references: [id], onDelete: Restrict)

  @@index([inventoryLevelId])
  @@unique([idempotencyKey])
}

model AuditEvent {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  actorUserId   String
  correlationId String
  occurredAt    DateTime @default(now())
  metadataJson  String?

  @@index([entityType, entityId])
}
